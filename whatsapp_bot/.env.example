# ===========================================
# Price Collector WhatsApp Bot - Configuração
# ===========================================

# API do Price Collector (conecta internamente)
API_BASE_URL=http://localhost:8000/api/v1
API_TIMEOUT=30000

# CEP padrão (usado quando usuário não informa)
DEFAULT_CEP=01310100

# Configurações do Bot
BOT_NAME=PriceBot
BOT_PREFIX=!

# Rate Limiting (mensagens por minuto por usuário)
RATE_LIMIT_PER_USER=10

# Números autorizados (separados por vírgula, vazio = todos)
# Formato: 5511999999999 (código país + DDD + número)
ALLOWED_NUMBERS=

# Números de admin
ADMIN_NUMBERS=

# Logging
LOG_LEVEL=info

# Ambiente
NODE_ENV=development
